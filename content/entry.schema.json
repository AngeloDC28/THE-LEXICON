{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexicon entry",
  "description": "Shape of one entry under content/entries/<id>.json. Enforced by .github/scripts/validate-entries.mjs (zero-dep) and consumable by ajv if you ever want richer validation.",
  "type": "object",
  "required": [
    "id",
    "title",
    "year",
    "season",
    "images",
    "tags",
    "notes",
    "published",
    "summary_plain"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Points to entry.schema.json — enables editor autocomplete. Not validated at runtime."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Must equal the JSON filename (sans .json) and match content/order.json."
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "subtitle": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "season": {
      "enum": [
        "SS",
        "AW",
        "Cruise",
        "Pre-Fall",
        "Couture-SS",
        "Couture-AW"
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^THE-LEXICON-ASSETS/"
          },
          "hotspots": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hotspot"
            }
          },
          "content_note": {
            "type": "string",
            "minLength": 3,
            "description": "Short warning shown before this look, e.g. \"Nudity\". The image is blurred until the reader chooses to see it."
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "required": [
        "brand",
        "era",
        "politics",
        "theories",
        "gender",
        "materials",
        "geography",
        "anatomy",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 2
        },
        "era": {
          "type": "string"
        },
        "politics": {
          "type": "string"
        },
        "theories": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "geography": {
          "type": "string"
        },
        "anatomy": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "object",
      "required": [
        "provenance",
        "strategy",
        "critique"
      ],
      "properties": {
        "provenance": {
          "type": "string",
          "minLength": 50
        },
        "strategy": {
          "type": "string",
          "minLength": 50
        },
        "critique": {
          "type": "string",
          "minLength": 50
        }
      }
    },
    "summary_plain": {
      "type": "string",
      "minLength": 80,
      "maxLength": 320,
      "description": "25-40 words for a reader new to fashion: what happened, then why people still talk about it. No theory words. Used on cards, at the top of the entry and as the link-preview description."
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the entry first went online (YYYY-MM-DD). Used as the publication date in citations."
    },
    "photo_credit": {
      "type": "string",
      "description": "The photographer / agency credit exactly as the image source publishes it, e.g. \"Filippo Fior / Gorunway.com\". Shown under every image. Empty only while the entry is listed in content/credits-pending.json."
    },
    "vibes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plain-language aesthetic/vibe tags for discovery by non-academic audiences."
    },
    "image_source": {
      "type": "object",
      "description": "Where this entry's runway images were obtained. Shown with the credit line; the URL lets a rights holder find the original.",
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "description": "e.g. \"Vogue Runway\""
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "References behind the analysis: reviews, books, catalogues, interviews. Shown as a \"Sources\" list on the entry and collected on the site-wide bibliography.",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "hotspot": {
      "type": "object",
      "required": [
        "x",
        "y",
        "label",
        "description"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publication": {
          "type": "string",
          "description": "Publisher, journal, newspaper or site"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "description": "YYYY, YYYY-MM or YYYY-MM-DD"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "type": {
          "enum": [
            "review",
            "book",
            "article",
            "catalogue",
            "interview",
            "video",
            "archive",
            "other"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
