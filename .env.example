# ─────────────────────────────────────────────────────────────────────────────
# THE LEXICON — environment variable template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public anon key — safe to expose in browser JS) ────────────────
# Found in: Supabase Dashboard → Project Settings → API → Project URL / anon key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase service key (NEVER expose in the browser / never commit) ────────
# Only needed for running supabase/migrate.mjs locally.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────────
# Vercel environment variables (set these in the Vercel dashboard, not here):
#   SUPABASE_URL       → same as above
#   SUPABASE_ANON_KEY  → same as above
# The service key is NEVER added to Vercel — it is only used locally for
# one-time data migration.
# ─────────────────────────────────────────────────────────────────────────────
