{
  "name": "the-lexicon",
  "version": "1.0.0",
  "description": "Forensic visual culture research terminal",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "node .github/scripts/check.mjs && node .github/scripts/validate-entries.mjs && node .github/scripts/check-assets.mjs && node .github/scripts/validate-translations.mjs",
    "build-data": "node .github/scripts/build-data.mjs",
    "build-translations": "node .github/scripts/build-translations.mjs",
    "sync-content-keys": "node .github/scripts/sync-content-keys.mjs",
    "translate-content": "node .github/scripts/translate-content.mjs",
    "measure-images": "node .github/scripts/measure-images.mjs",
    "optimize-images": "node .github/scripts/optimize-images.mjs && node .github/scripts/measure-images.mjs",
    "new-entry": "node .github/scripts/new-entry.mjs",
    "stats": "node .github/scripts/stats.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  },
  "license": "SEE LICENSE IN LICENSE FILE"
}
