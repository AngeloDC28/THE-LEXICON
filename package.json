{
  "name": "the-lexicon",
  "version": "1.0.0",
  "description": "Forensic visual culture research terminal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node .github/scripts/check.mjs && node .github/scripts/validate-entries.mjs && node .github/scripts/check-assets.mjs && node .github/scripts/validate-translations.mjs",
    "build-data": "node .github/scripts/build-data.mjs",
    "build-translations": "node .github/scripts/build-translations.mjs",
