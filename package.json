{
  "name": "the-lexicon",
  "version": "1.0.0",
  "description": "Forensic visual culture research terminal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node .github/scripts/check.mjs && node .github/scripts/validate-entries.mjs && node .github/scripts/check-assets.mjs && node .github/scripts/validate-translations.mjs",
    "build-data": "node .github/scripts/build-data.mjs",
    "build-translations": "node .github/scripts/build-translations.mjs",
    "sync-content-keys": "node .github/scripts/sync-content-keys.mjs",
    "translate-content": "node .github/scripts/translate-content.mjs",
    "measure-images": "node .github/scripts/measure-images.mjs",
    "optimize-images": "node .github/scripts/optimize-images.mjs && node .github/scripts/measure-images.mjs",
    "new-entry": "node .github/scripts/new-entry.mjs",
    "stats": "node .github/scripts/stats.mjs",
    "bust-cache": "node .github/scripts/bust-cache.mjs",
    "generate-sitemap": "node .github/scripts/generate-sitemap.mjs",
    "generate-feed": "node .github/scripts/generate-feed.mjs",
    "generate-entry-pages": "node .github/scripts/generate-entry-pages.mjs",
    "preflight": "npm run sync-content-keys && npm run build-data && npm run build-translations && npm run measure-images && npm run generate-sitemap && npm run generate-feed && npm run generate-entry-pages && npm run check && npm run bust-cache",
    "prebuild": "npm run check && node .github/scripts/build-data.mjs && node .github/scripts/build-translations.mjs && node .github/scripts/measure-images.mjs && node .github/scripts/bust-cache.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^10.0.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "vite": "^5.0.0"
  },
  "license": "SEE LICENSE IN LICENSE FILE"
}
